<mxfile host="app.diagrams.net" version="29.5.2">
  <diagram id="agentic-newsletter-graph-v2" name="AgenticNewsLetter LangGraph">
    <mxGraphModel dx="1426" dy="743" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="AgenticNewsLetter — LangGraph Pipeline" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="640" height="40" as="geometry" />
        </mxCell>

        <mxCell id="state" value="NewsletterState (TypedDict)&#xa;topic · subtopic · style · research_data · newsletter_draft · steps_taken · bedrock_client · bedrock_model_id" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="1040" height="50" as="geometry" />
        </mxCell>

        <mxCell id="tavily" value="Tavily Search API&#xa;news topic, depth=advanced" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="240" y="180" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bedrock" value="AWS Bedrock&#xa;ChatBedrock(state.bedrock_model_id)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="520" y="180" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="smtp" value="SMTP (Gmail)&#xa;smtp.gmail.com:587 + STARTTLS" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="800" y="180" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="start" value="START" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="80" height="60" as="geometry" />
        </mxCell>
        <mxCell id="researcher" value="researcher_node" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="220" y="290" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="writer" value="writer_node" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="500" y="290" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="publisher" value="publisher_node" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="780" y="290" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="end" value="END" style="ellipse;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1060" y="300" width="80" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e-start-r" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="start" target="researcher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-r-w" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="researcher" target="writer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-w-p" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="writer" target="publisher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-p-end" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;" edge="1" parent="1" source="publisher" target="end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e-tavily" style="endArrow=classic;startArrow=classic;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="researcher" target="tavily">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-bedrock" style="endArrow=classic;startArrow=classic;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="writer" target="bedrock">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-smtp" style="endArrow=classic;html=1;rounded=0;dashed=1;" edge="1" parent="1" source="publisher" target="smtp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ann-researcher" value="researcher_node&#xa;&#xa;- Build news query from state.topic / state.subtopic&#xa;- Invoke TavilySearch (max_results=5, depth=advanced, topic=news)&#xa;- Collate title + url + content per result&#xa;- Writes: state.research_data&#xa;- Appends 'researcher_complete' to steps_taken" style="swimlane;startSize=0;align=left;verticalAlign=top;fontStyle=0;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="410" width="240" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ann-writer" value="writer_node&#xa;&#xa;- Resolve style from state.style (default ELI5)&#xa;- Build ChatPromptTemplate (system + human)&#xa;- Invoke ChatBedrock (temperature=0.7, max_tokens=2048)&#xa;- Writes: state.newsletter_draft&#xa;- On exception (e.g. guardrail block):&#xa;  draft = 'Content blocked…' + steps_taken += ['blocked']" style="swimlane;startSize=0;align=left;verticalAlign=top;fontStyle=0;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="500" y="410" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="ann-publisher" value="publisher_node&#xa;&#xa;- Read SENDER / RECEIVER from configurable&#xa;- markdown.markdown(state.newsletter_draft) -&gt; HTML&#xa;- Build MIMEMultipart email&#xa;  Subject: 📊 DS Pulse: topic - subtopic&#xa;- SMTP login + send_message (smtp.gmail.com:587, STARTTLS)&#xa;- Appends 'publisher_complete' to steps_taken" style="swimlane;startSize=0;align=left;verticalAlign=top;fontStyle=0;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="410" width="280" height="200" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Legend&#xa;&#xa;Solid arrow: LangGraph edge (StateGraph)&#xa;Dashed arrow: external service call&#xa;Yellow box: external dependency&#xa;Green box: LangGraph node&#xa;Blue ellipse: graph entry / exit" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="410" width="120" height="160" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
